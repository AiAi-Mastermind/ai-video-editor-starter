# Find this in ElevenLabs under Developers, then API keys.
ELEVENLABS_API_KEY=
# Find this in ElevenLabs under My Voices, below your professional voice.
ELEVENLABS_VOICE_ID=
# Find this in HeyGen under Avatars, in your clone details or the address bar.
HEYGEN_AVATAR_ID=
# Leave this empty. You do not need it and filling it in costs extra money.
# Your HeyGen plan credits are spent by the signed-in connection that setup registers for you.
# A HeyGen API key spends a separate pay-as-you-go balance instead, about $1 per minute of video,
# bought in $5 blocks, and your $29 plan credits go unused. Only fill this in if you have
# deliberately bought API credits and asked your agent to use them.
HEYGEN_API_KEY=
# These are the wide and vertical video sizes made by default.
DEFAULT_OUTPUT_SIZES=16:9,9:16
# This keeps the first paid test short.
TEST_CLIP_SECONDS=10
